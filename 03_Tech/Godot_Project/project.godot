; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows this.
;
; If the file is corrupted, it can be recovered by an editor.
config_version=5

[application]

config/name="Division of Continuity Management"
config/description="A bureaucratic cosmic horror narrative game.
You are a Processor. Your job is to file the universe.
The universe is filing you back."
run/main_scene="res://scenes/boot/BootScreen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/tags=PackedStringArray("narrative", "horror", "bureaucracy")

[autoload]

ContinuityState="*res://scripts/autoloads/ContinuityState.gd"
SaveSystem="*res://scripts/systems/SaveSystem.gd"
CaseLoader="*res://scripts/systems/CaseLoader.gd"
RippleProcessor="*res://scripts/systems/RippleProcessor.gd"
EndingEvaluator="*res://scripts/systems/EndingEvaluator.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
ui_file_approve={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}
ui_open_file={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":70,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.039, 0.039, 0.059, 1)
